; One goal and planner per PeTTa process. The Python runner substitutes MODE/GOAL.
!(import! &self ../../other_hyperon/PeTTa-OpenPSI/main/mind-agents/action-planner/action-planner-v2)
!(import! &self ../../other_hyperon/PeTTa-OpenPSI/main/mind-agents/action-planner/action-planner-v1)
!(import! &self ../../other_hyperon/PeTTa-OpenPSI/main/mind-agents/action-planner/prism-openpsi)

!(bind! &freshRules (new-space))
!(addRulesToSpace &freshRules)

(= (Fresh.Replay $plan $state $goal)
   (if (== $plan ())
       (== $state $goal)
       (let* (($action (car-atom $plan))
              ($rest (cdr-atom $plan))
              ($successors (applyCurrentActions ($action) $state () &freshRules)))
             (if (== $successors ())
                 False
                 (let* (($pair (car-atom $successors))
                        (($next) (cdr-atom $pair)))
                       (Fresh.Replay $rest $next $goal))))))

(= (Fresh.Select $mode $candidates $goal $visited)
   (if (== $mode PRISM)
       (PRISM.OpenPsi.Select $candidates $goal &freshRules $visited)
       (let ($distance $pair)
            (findMinDistance $candidates $goal 1000 () &freshRules)
            $pair)))

(= (Fresh.Plan $mode $state $goal $budget $visited $steps $plan)
   (if (== $state $goal)
       (RunResult Success $steps (reverse $plan ()))
       (if (<= $budget 0)
           (RunResult Budget $steps (reverse $plan ()))
           (let* (($actions (getApplicableActions $state &freshRules))
                  ($candidates (applyCurrentActions $actions $state () &freshRules))
                  ($pick (Fresh.Select $mode $candidates $goal $visited)))
                 (if (== $pick ())
                     (RunResult DeadEnd $steps (reverse $plan ()))
                     (let* (($action (car-atom $pick))
                            (($next) (cdr-atom $pick)))
                           (if (is-member $next $visited)
                               (RunResult Cycle $steps (reverse $plan ()))
                               (Fresh.Plan $mode $next $goal (- $budget 1)
                                           (cons-atom $state $visited)
                                           (+ $steps 1)
                                           (cons-atom $action $plan)))))))))

(= (Fresh.Choose $mode $goal)
   (if (== $mode V1)
       (let* (($plan (planner &freshRules Conversation-Started $goal))
              ($steps (size-atom $plan))
              ($valid (Fresh.Replay $plan Conversation-Started $goal)))
             (if (> $steps 15)
                 (RunResult Budget $steps $plan)
                 (if $valid
                     (RunResult Success $steps $plan)
                     (RunResult Invalid $steps $plan))))
       (Fresh.Plan $mode Conversation-Started $goal 15 () 0 ())))

(= (Fresh.Run $mode $goal $round)
   (let* (($start (py-call (time.perf_counter)))
          ($result (Fresh.Choose $mode $goal))
          ($end (py-call (time.perf_counter))))
         (println! (FRESH_EVAL $mode $goal $round $result (- $end $start)))))

!(Fresh.Run __MODE__ __GOAL__ cold)
!(Fresh.Run __MODE__ __GOAL__ warm)
